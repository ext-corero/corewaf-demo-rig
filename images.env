# images.env — every image the demo rig runs, pinned. Single source of truth for
# "which build of CoreWAF is this rig". Registry-relative paths mirror GHCR
# (io.corewaf.ghcr/<ghcr path>); tags are the immutable X.Y.Z-<githash> form.
#
# NOTE: guest-SERVICE pins here serve the LEGACY compose path only — on the
# orchestrator path (RIG_LAUNCH=orchestrator) the release knob is
# services/<svc>/service.json (sources/variables). scripts/check-pins.sh
# asserts the two stay in sync until the legacy path retires.
# Bump with: aws ecr describe-images --repository-name io.corewaf.ghcr/ext-corero/<path>

RIG_REGISTRY=123517950721.dkr.ecr.us-east-1.amazonaws.com/io.corewaf.ghcr/ext-corero

# NOTE (RIG_LAUNCH=orchestrator): guest-service pins below serve the LEGACY
# compose launch path only — the orchestrator path pins images in
# services/*/service.json (sources/variables), the single release knob there.

# The orchestrator itself (the bootstrapping tool — it cannot pin itself).
RIG_ORCHESTRATOR_REF=123517950721.dkr.ecr.us-east-1.amazonaws.com/io.corewaf.ghcr/ext-corero/waf/orchestrator:0.1.8-67baec2

# ── rig (infra VM) images ──────────────────────────────────────────────
WAF_API_IMAGE=waf/api
WAF_API_TAG=0.1.6-0a468c8
WAF_GUI_IMAGE=waf/gui
WAF_GUI_TAG=2.0.25-9d3b80f
CADDY_INTERNAL_IMAGE=waf/caddy-docker-proxy
CADDY_INTERNAL_TAG=1.0.1-dc8f18b
TUNNEL_GW_IMAGE=waf/tunnel-gateway
TUNNEL_GW_TAG=0.0.21-16698a7
DNS_BRIDGE_IMAGE=waf/dns-bridge
DNS_BRIDGE_TAG=0.2.1-9c45d13
COREDNS_REDIS_IMAGE=waf/coredns-redis
COREDNS_REDIS_TAG=0.2.1-9c45d13
SECRETS_MANAGER_IMAGE=waf/secrets-manager
SECRETS_MANAGER_TAG=3.0.2-ee5ce66

# ── public upstreams (unchanged from the source-build era) ─────────────
ETCD_IMAGE=gcr.io/etcd-development/etcd:v3.5.13
REDIS_IMAGE=redis:7-alpine
STEP_CA_IMAGE=smallstep/step-ca:0.27.5
STEP_CLI_IMAGE=smallstep/step-cli:0.27.5
LOKI_IMAGE=grafana/loki:3.1.1
MIMIR_IMAGE=grafana/mimir:2.13.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
GRAFANA_IMAGE=grafana/grafana:11.2.0

# ── kit images: "<ecr path>:<tag> => <name the public starter-kit compose expects>"
# kit-prep pulls the left side from ECR inside the kit VM and re-tags it to the
# right side, so the unmodified starter-kit compose (pull_policy missing) never
# contacts GHCR. Public ones are pulled as-is.
KIT_IMAGES="waf/network-loader:0.1.13-c20a609=>ghcr.io/ext-corero/waf/network-loader:0.1.0 waf/caddy-bridge:0.0.8-995f017=>ghcr.io/ext-corero/waf/caddy-bridge:tunnel-v0 waf/caddy-waf:0.0.5-73b77d4=>ghcr.io/ext-corero/waf/caddy-waf:latest services/core/caddy-docker-proxy:1.0.2-4895233=>ghcr.io/ext-corero/services/core/caddy-docker-proxy:1.0.0"
KIT_PUBLIC_IMAGES="grafana/alloy:v1.7.5 valkey/valkey:8"

# ── VM base image (OCI artifact built by .github/workflows/base-image.yml) ──
# node/bin/rig-init pulls it into the rig-base volume and verifies the sha256.
RIG_BASE_REF=123517950721.dkr.ecr.us-east-1.amazonaws.com/io.corewaf.ghcr/rig/base-image:3.23.4-c2a335c
RIG_BASE_SHA256=455352f198414225eefce2878209c937ee7674df2272b12faaae541bfd65cb30

# ── rig-node container image (built by .github/workflows/node-image.yml) ──
RIG_NODE_IMAGE=123517950721.dkr.ecr.us-east-1.amazonaws.com/io.corewaf.ghcr/rig/node:3.23-e4056ff

# rig-launcher: zero-install docker-run entry point, built by
# .github/workflows/launcher-image.yml (self-identifies at runtime — no pin here).

# starter-kit ref for kit staging: main on the dev channel; a release pins the exact commit.
KIT_REF_PIN=main

# Backstage portal (plain container, portal profile); twin pushed by the workspace CI.
BACKSTAGE_TAG=0.1.2-88af09d

# --- Flatcar (the infra-guest default; kits stay Alpine) --------------------------
# Stock upstream image republished byte-identical (A/B update path preserved).
RIG_FLATCAR_VERSION=4593.2.5
RIG_FLATCAR_REF=123517950721.dkr.ecr.us-east-1.amazonaws.com/io.corewaf.ghcr/os-images/flatcar-qemu:4593.2.5
RIG_FLATCAR_SHA256=524c8e1f1bd421edea41c2ad9bcc038d8660f54ac50ef2a84074ccc14fdfc046
# Bootstrap payload: scratch container image (sysext/ + bin/), docker-fetched in-guest.
RIG_BOOTSTRAP_ARTIFACTS_REF=123517950721.dkr.ecr.us-east-1.amazonaws.com/io.corewaf.ghcr/os-images/bootstrap-artifacts:2.34.0-5943412
RIG_COMPOSE_SYSEXT_VERSION=2.34.0
# Vendored prod Butane template pin (scripts/check-template-sync.sh)
RIG_PROD_TEMPLATE_SHA256=4245a5c7487b59c0209e5bc4e28addf31f09cf95f941eeb8b8587951f3309176
# Render toolchain (terraform + poseidon/ct) is pinned where it is installed:
# node/Dockerfile (model 1/2) and qemu/prep-host.sh (model 3).

# Track 3 (data path) origin: OWASP Juice Shop — the protected entity the kits' WAF fronts
JUICE_SHOP_IMAGE=bkimminich/juice-shop:v20.2.0
