#!/usr/bin/env bash
# console — interactive serial console (ttyS1) of this node's guest. Login alpine/alpine
# on kits; Ctrl-] then Enter... use Ctrl-\ (socat) to detach.
source "${RIG_LIB:-/usr/local/bin/rig-lib.sh}" 2>/dev/null || RUN_DIR="${RUN_DIR:-/run}"
exec socat -,raw,echo=0,escape=0x1d unix-connect:"${RUN_DIR}/ttyS1.sock"
