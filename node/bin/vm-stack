#!/usr/bin/env bash
# vm-stack — (re)start the role's docker stack inside the guest. Identical to the
# libvirt-era `vmlab.sh stack`: the booted node is the source of truth; compose
# reads /etc/corewaf-bootstrap + inventory.env + images.env from /opt/v2.
source "${RIG_LIB:-/usr/local/bin/rig-lib.sh}"
[[ "$ROLE" == kit ]] && { log "kit nodes have no rig stack"; exit 0; }
files="-f compose/$ROLE.yml"; build=""
if [[ "${RIG_MODE:-pull}" == source ]]; then files="$files -f compose/build/$ROLE.yml"; build="--build"; fi
# the guest's dockerd may still be starting right after boot
vm-ssh 'doas rc-service docker start >/dev/null 2>&1 || true; for i in $(seq 1 60); do doas docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo "dockerd not ready" >&2; exit 1' || exit 1
run() { vm-ssh "doas rc-service docker start >/dev/null 2>&1 || true; doas sh -c 'cd /opt/v2 && set -a; . /etc/corewaf-bootstrap; [ -f /opt/shared-secrets/rig-secrets.env ] && . /opt/shared-secrets/rig-secrets.env; set +a; HOSTNAME=\"\$(hostname)\" RIG_SRC=${RIG_WORKSPACE_MOUNT:-/opt/corewaf-workspace} docker compose --env-file inventory.env --env-file images.env $1 up $build -d'"; }
rc=0
run "$files" || rc=$?
if [[ "$ROLE" == dns ]]; then run "-f compose/secrets.yml" || rc=$?; fi
exit $rc
