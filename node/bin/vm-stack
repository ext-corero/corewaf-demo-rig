#!/usr/bin/env bash
# vm-stack — (re)start the role's docker stack inside the guest.
# Two launch paths, selected by RIG_LAUNCH (opt-in flag; default = legacy):
#   compose (default): the original contract — docker compose with
#     inventory.env/images.env + compose/<role>.yml from /opt/v2 (unchanged).
#   orchestrator: prod-shape system configuration — per-service service.json +
#     compose.yml under /opt/v2/services/<svc>, consumed by the orchestrator's
#     LOCAL verb (compose up). Env roots in the bootstrap file (bind-mounted at
#     /etc/bootstrap inside the orchestrator container) + manifest variables.
#     Step 1 of the orchestrator migration; `run --artifact-ref` = Step 2.
source "${RIG_LIB:-/usr/local/bin/rig-lib.sh}"
[[ "$ROLE" == kit ]] && { log "kit nodes have no rig stack"; exit 0; }
# the guest's dockerd may still be starting right after boot
vm-ssh "$GUEST_SUDO $(docker_start_cmd) >/dev/null 2>&1 || true; for i in \$(seq 1 60); do $GUEST_SUDO docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo 'dockerd not ready' >&2; exit 1" || exit 1

if [[ "${RIG_LAUNCH:-compose}" == orchestrator ]]; then
    [[ "${RIG_MODE:-pull}" == source ]] && die "RIG_MODE=source is the legacy path's build mode; with RIG_LAUNCH=orchestrator use a services/<svc>/compose.override.yml dev pin (see README)"
    [[ -n "${RIG_ORCHESTRATOR_REF:-}" ]] || die "RIG_ORCHESTRATOR_REF not set (images.env)"
    rolefile="$V2_DIR/services/roles/$ROLE"
    [[ -s "$rolefile" ]] || die "no services list at services/roles/$ROLE"
    # Registry token for the orchestrator's own `docker compose pull` — client-side
    # auth lives INSIDE the orchestrator container (regauth env seam), not in the
    # guest root's docker config. Token visible on the guest cmdline: acceptable,
    # the rig is open by design.
    tok="$(reg_token 2>/dev/null)"
    [[ -n "$tok" ]] || tok="$(jq -r --arg h "$(reg_host)" '.auths[$h].auth // empty' "$AUTH_DIR/docker-config.json" 2>/dev/null | base64 -d 2>/dev/null | cut -d: -f2-)"
    [[ -n "$tok" ]] || die "cannot obtain an ECR token (reg_token / $AUTH_DIR/docker-config.json)"
    # Warm-flip hygiene: the legacy projects hold the published ports.
    vm-ssh "$GUEST_SUDO sh -c 'for p in compose obs-rig secrets-rig; do docker compose -p \$p down --remove-orphans >/dev/null 2>&1 || true; done'" || true
    rc=0
    while IFS= read -r svc; do
        [[ -z "$svc" || "$svc" == \#* ]] && continue
        log "orchestrator compose up: $svc"
        # Stage the service dir onto the nodestate share GUEST-side (rw at
        # /opt/rig-state via 9p; host sees it under $STATE_DIR/share/services).
        # Fresh copy each run; guest-side keeps the 9p dentry cache coherent
        # (a host-side rm+recreate under the live mount yields phantom EEXIST
        # on the orchestrator's later mkdir). Picks up the git-ignored
        # compose.override.yml dev pin. share/ready is untouched.
        vm-ssh "$GUEST_SUDO sh -c 'rm -rf /opt/rig-state/services/$svc && mkdir -p /opt/rig-state/services && cp -r --no-preserve=ownership /opt/v2/services/$svc /opt/rig-state/services/'" </dev/null \
            || { rc=$?; log "staging $svc failed (rc=$rc)"; break; }
        if [[ "$svc" == dns ]]; then
            # Dev-path env-asset fill: compose up skips asset staging (attested-only),
            # so seed the dns-seed volume here. Step 2's attested run pulls the real
            # zone-<zone>-seed artifact instead. The orchestrator image is alpine.
            vm-ssh "$GUEST_SUDO docker run --rm --entrypoint /bin/sh -v dns-seed:/dst -v /opt/v2/seed:/src:ro $RIG_ORCHESTRATOR_REF -c 'cp /src/rig.internal.zone /dst/'" </dev/null \
                || { rc=$?; log "dns-seed volume fill failed (rc=$rc)"; break; }
        fi
        cmd="$GUEST_SUDO docker run --rm"
        cmd+=" -v /var/run/docker.sock:/var/run/docker.sock"
        cmd+=" -v /etc/corewaf-bootstrap:/etc/bootstrap:ro"
        cmd+=" -v /opt/rig-state/services/$svc:/opt/rig-state/services/$svc"
        cmd+=" -e COREWAF_REGISTRY=$(reg_host)"
        cmd+=" -e COREWAF_REGISTRY_USERNAME=AWS"
        cmd+=" -e COREWAF_REGISTRY_PASSWORD='$tok'"
        cmd+=" $RIG_ORCHESTRATOR_REF compose up --manifest /opt/rig-state/services/$svc/service.json"
        vm-ssh "$cmd" </dev/null || { rc=$?; log "orchestrator failed on $svc (rc=$rc)"; break; }
    done < "$rolefile"
    # a successful (re)start IS readiness — same health-flag contract as legacy
    [[ $rc -eq 0 ]] && touch "$STATE_DIR/share/ready"
    exit $rc
fi

# ── legacy compose path (default) ──────────────────────────────────────────
files="-f compose/$ROLE.yml"; build=""
if [[ "${RIG_MODE:-pull}" == source ]]; then files="$files -f compose/build/$ROLE.yml"; build="--build"; fi
# flatcar: `docker compose` arrives via the bootstrap sysext (install-bootstrap.service,
# after docker) — wait for it so a fast vm-stack doesn't race the artifact install
if [[ "$GUEST_SUDO" == sudo ]]; then
    vm-ssh 'for i in $(seq 1 60); do sudo docker compose version >/dev/null 2>&1 && exit 0; sleep 2; done; echo "docker compose (bootstrap sysext) never arrived" >&2; exit 1' || exit 1
fi
run() { vm-ssh "$GUEST_SUDO $(docker_start_cmd) >/dev/null 2>&1 || true; $GUEST_SUDO sh -c 'cd /opt/v2 && set -a; . /etc/corewaf-bootstrap; [ -f /opt/shared-secrets/rig-secrets.env ] && . /opt/shared-secrets/rig-secrets.env; set +a; HOSTNAME=\"\$(hostname)\" RIG_SRC=${RIG_WORKSPACE_MOUNT:-/opt/corewaf-workspace} docker compose --env-file inventory.env --env-file images.env $1 up $build -d'"; }
rc=0
run "$files" || rc=$?
if [[ "$ROLE" == dns ]]; then run "-f compose/secrets.yml" || rc=$?; fi
# a successful (re)start IS readiness — restore the health flag so a manual
# rerun (the failure hint) turns the container healthy again, not just the boot path
[[ $rc -eq 0 ]] && touch "$STATE_DIR/share/ready"
exit $rc
