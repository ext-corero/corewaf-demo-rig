#!/usr/bin/env bash
# rig-init — one-shot, re-run on every `compose up`:
#   base image   oras pull the pinned VM image into /rig/base (sha256 verified,
#                generations kept — running overlays reference them by path)
#   ca           rig root CA (openssl, EC P-256, 10y) if missing
#   secrets      rig-secrets.env (step-ca passwords) if missing
#   ssh          lab keypair if missing
#   auth         docker-config.json for the guests (fresh 12h ECR token every run)
set -euo pipefail
source "${RIG_LIB:-/usr/local/bin/rig-lib.sh}"
mkdir -p "$BASE_DIR" "$CA_DIR" "$SECRETS_DIR" "$AUTH_DIR" "$SSH_DIR"

log "registry: $(reg_host)"
TOKEN="$(reg_token)"; [[ -n "$TOKEN" && "$TOKEN" != null ]] \
  || die "cannot mint a registry token — pass AWS_PROFILE (with ~/.aws mounted) or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for a user in IAM group corewaf-ecr-pull"
printf '{"auths": {"%s": {"auth": "%s"}}}\n' "$(reg_host)" "$(printf 'AWS:%s' "$TOKEN" | base64 -w0)" > "$AUTH_DIR/docker-config.json"
chmod 600 "$AUTH_DIR/docker-config.json"; log "auth: docker-config.json refreshed"
# Durable form for the guests: the AWS key itself + the ECR credential helper (baked
# into the base image) so the guest mints its own tokens forever — no 12h expiry.
AK="${AWS_ACCESS_KEY_ID:-}"; SK="${AWS_SECRET_ACCESS_KEY:-}"
if [[ -z "$AK" && -n "${AWS_PROFILE:-}" && -f /root/.aws/credentials ]]; then
    AK="$(awk -v p="[$AWS_PROFILE]" '$0==p{f=1;next} /^\[/{f=0} f&&/aws_access_key_id/{sub(/.*= */,"");print;exit}' /root/.aws/credentials)"
    SK="$(awk -v p="[$AWS_PROFILE]" '$0==p{f=1;next} /^\[/{f=0} f&&/aws_secret_access_key/{sub(/.*= */,"");print;exit}' /root/.aws/credentials)"
fi
if [[ -n "$AK" && -n "$SK" ]]; then
    umask 077; printf '[default]\naws_access_key_id = %s\naws_secret_access_key = %s\nregion = %s\n' "$AK" "$SK" "$(reg_region)" > "$AUTH_DIR/aws-credentials"; umask 022
    log "auth: aws-credentials for the guests' credential helper"
else rm -f "$AUTH_DIR/aws-credentials"; log "auth: no static key available — guests get a 12h token only"; fi

# ---- base image ----
GEN="${RIG_BASE_REF##*:}"; IMG="$BASE_DIR/corewaf-rig-base-${GEN}.qcow2"
if [[ -s "$IMG" ]] && { [[ -z "${RIG_BASE_SHA256:-}" ]] || echo "$RIG_BASE_SHA256  $IMG" | sha256sum -c --quiet - 2>/dev/null; }; then
    log "base: $IMG present (sha ok)"
else
    log "base: pulling $RIG_BASE_REF"
    printf '%s' "$TOKEN" | oras login --username AWS --password-stdin "$(reg_host)" >/dev/null
    tmp="$(mktemp -d "$BASE_DIR/.fetch.XXXX")"; trap 'rm -rf "$tmp"' EXIT
    # 786 MB from ECR (layers redirect to S3): retry — transient DNS/VPN hiccups are
    # common on laptops, and a failed rig-init blocks the whole cold start.
    for attempt in 1 2 3 4 5; do
        ( cd "$tmp" && rm -f ./*.qcow2 && oras pull "$RIG_BASE_REF" >/dev/null ) && break
        [[ $attempt -lt 5 ]] || die "base image pull failed after $attempt attempts (network/DNS to ECR + S3?)"
        log "base: pull attempt $attempt failed — retrying in $((attempt*10))s"; sleep $((attempt*10))
    done
    f="$(ls "$tmp"/*.qcow2)"; got="$(sha256sum "$f" | cut -d' ' -f1)"
    [[ -z "${RIG_BASE_SHA256:-}" || "$got" == "$RIG_BASE_SHA256" ]] || die "base image sha256 mismatch: got $got want $RIG_BASE_SHA256"
    mv -f "$f" "$IMG"; echo "$got  $(basename "$IMG")" > "$IMG.sha256"; log "base: fetched (sha256 $got)"
fi
ln -sfn "$(basename "$IMG")" "$BASE_DIR/current.qcow2"

# ---- flatcar OS image (RIG_OS=flatcar; multi-cloud model: OS images come from OCI) ----
if [[ "${RIG_OS:-alpine}" == flatcar ]]; then
    [[ -n "${RIG_FLATCAR_REF:-}" ]] || die "RIG_OS=flatcar but RIG_FLATCAR_REF is not pinned in images.env"
    FGEN="${RIG_FLATCAR_REF##*:}"; FIMG="$BASE_DIR/corewaf-rig-flatcar-${FGEN}.qcow2"
    if [[ -s "$FIMG" ]] && { [[ -z "${RIG_FLATCAR_SHA256:-}" ]] || echo "$RIG_FLATCAR_SHA256  $FIMG" | sha256sum -c --quiet - 2>/dev/null; }; then
        log "flatcar: $FIMG present (sha ok)"
    else
        log "flatcar: pulling $RIG_FLATCAR_REF"
        printf '%s' "$TOKEN" | oras login --username AWS --password-stdin "$(reg_host)" >/dev/null
        tmp2="$(mktemp -d "$BASE_DIR/.fetch.XXXX")"
        for attempt in 1 2 3 4 5; do
            ( cd "$tmp2" && rm -f ./*.qcow2 && oras pull "$RIG_FLATCAR_REF" >/dev/null ) && break
            [[ $attempt -lt 5 ]] || die "flatcar image pull failed after $attempt attempts (network/DNS to ECR + S3?)"
            log "flatcar: pull attempt $attempt failed — retrying in $((attempt*10))s"; sleep $((attempt*10))
        done
        f="$(ls "$tmp2"/*.qcow2)"; got="$(sha256sum "$f" | cut -d' ' -f1)"
        [[ -z "${RIG_FLATCAR_SHA256:-}" || "$got" == "$RIG_FLATCAR_SHA256" ]] || die "flatcar image sha256 mismatch: got $got want $RIG_FLATCAR_SHA256"
        mv -f "$f" "$FIMG"; echo "$got  $(basename "$FIMG")" > "$FIMG.sha256"; rm -rf "$tmp2"; log "flatcar: fetched (sha256 $got)"
    fi
    ln -sfn "$(basename "$FIMG")" "$BASE_DIR/current-flatcar.qcow2"
    [[ "${RIG_BOOTSTRAP_CARRIER:-}" == iso && ! -s "$BASE_DIR/rig-bootstrap.iso" ]]       && log "NOTE: RIG_BOOTSTRAP_CARRIER=iso but $BASE_DIR/rig-bootstrap.iso is missing — build it with scripts/build-bootstrap-iso.sh"
fi

# ---- CA ----
if [[ ! -s "$CA_DIR/root_ca.crt" || ! -s "$CA_DIR/root_ca_key" ]]; then
    log "ca: generating rig root CA"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
        -subj "/CN=CoreWAF Demo Rig Root CA" -keyout "$CA_DIR/root_ca_key" -out "$CA_DIR/root_ca.crt" \
        -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" 2>/dev/null
    chmod 600 "$CA_DIR/root_ca_key"
else log "ca: present"; fi

# ---- secrets ----
if [[ ! -s "$SECRETS_DIR/rig-secrets.env" ]]; then
    rnd() { head -c 24 /dev/urandom | base64 | tr -d '/+='; }
    umask 077; printf 'STEPCA_PASSWORD=%s\nSTEPCA_PROVISIONER_PASSWORD=%s\n' "$(rnd)" "$(rnd)" > "$SECRETS_DIR/rig-secrets.env"; umask 022
    log "secrets: rig-secrets.env generated"
else log "secrets: present"; fi

# ---- ssh ----
if [[ ! -s "$SSH_DIR/id_lab" ]]; then ssh-keygen -q -t ed25519 -N '' -f "$SSH_DIR/id_lab" -C rig-lab; log "ssh: keypair generated"; else log "ssh: present"; fi
chmod 600 "$SSH_DIR/id_lab"
log "init done"
