# local-rig v2 — single source of truth for the routed multi-VM topology.
#
# Sourced by up.sh / down.sh, by vmlab.sh (role -> ip/mac/fqdn), and rendered
# into the per-stack composes' env. Nothing else should hardcode an IP/FQDN.
#
# Topology: one routed libvirt subnet; VMs get deterministic IPs via DHCP
# reservations keyed on the MACs below (last MAC octet == IP host octet, so
# the mapping is eyeball-checkable). The two dns VMs are the resolvers.

RIG_NET_NAME=corewaf-rig
RIG_NET_BRIDGE=virbr-cwrig
RIG_NET_CIDR=192.168.150.0/24
RIG_NET_NETMASK=255.255.255.0
RIG_NET_HOST_GW=192.168.150.1
RIG_DOMAIN=rig.internal

# MAC prefix: 52:54:00 (libvirt/KVM) : 96 (=0d150, the third subnet octet)
# : 00 : <host-octet-hex>.  e.g. .10 -> ...:00:0a
RIG_MAC_PREFIX=52:54:00:96:00

# role | vm-name | ip | fqdn | mac-suffix(host octet, hex)
RIG_APP_NAME=rig2-app-1
RIG_APP_IP=192.168.150.10
RIG_APP_FQDN=app-1.rig.internal
RIG_APP_MAC=52:54:00:96:00:0a

RIG_DNS_1_NAME=rig2-dns-1
RIG_DNS_1_IP=192.168.150.21
RIG_DNS_1_FQDN=dns-1.rig.internal
RIG_DNS_1_MAC=52:54:00:96:00:15

RIG_DNS_2_NAME=rig2-dns-2
RIG_DNS_2_IP=192.168.150.22
RIG_DNS_2_FQDN=dns-2.rig.internal
RIG_DNS_2_MAC=52:54:00:96:00:16

RIG_GW_1_NAME=rig2-gw-1
RIG_GW_1_IP=192.168.150.31
RIG_GW_1_FQDN=gw-1.rig.internal
RIG_GW_1_MAC=52:54:00:96:00:1f

RIG_GW_2_NAME=rig2-gw-2
RIG_GW_2_IP=192.168.150.32
RIG_GW_2_FQDN=gw-2.rig.internal
RIG_GW_2_MAC=52:54:00:96:00:20

# Observability VM — loki + mimir + alertmanager + grafana (compose/obs.yml).
# .40 == 0x28; mac suffix matches the host octet like the rest of the fleet.
RIG_OBS_1_NAME=rig2-obs-1
RIG_OBS_1_IP=192.168.150.40
RIG_OBS_1_FQDN=obs-1.rig.internal
RIG_OBS_1_MAC=52:54:00:96:00:28

# A spare slot for the temporary 3rd gateway used in parallel-validation.
RIG_GW_3_NAME=rig2-gw-3
RIG_GW_3_IP=192.168.150.33
RIG_GW_3_FQDN=gw-3.rig.internal
RIG_GW_3_MAC=52:54:00:96:00:21

# Per-gateway IPAM partition. Each gateway allocates kit IPs out of its OWN
# disjoint sub-CIDR (carved from 100.64.0.0/16 as /18s -> 4 gateways max),
# so two gateways never hand out colliding tunnel IPs. The gateway's own WG
# server address is the .1 of its sub-CIDR. vmlab.sh `stack gw <n>` exports
# these as RIG_SELF_IPAM_CIDR / RIG_SELF_WG_ADDR for compose/gw.yml.
RIG_GW_1_IPAM_CIDR=100.64.0.0/18
RIG_GW_1_WG_ADDR=100.64.0.1/18
RIG_GW_2_IPAM_CIDR=100.64.64.0/18
RIG_GW_2_WG_ADDR=100.64.64.1/18
RIG_GW_3_IPAM_CIDR=100.64.128.0/18
RIG_GW_3_WG_ADDR=100.64.128.1/18

# Resolver list handed to every VM's resolv.conf (the two dns VMs, primary).
RIG_RESOLVERS="192.168.150.21 192.168.150.22"
# Bootstrap/last-resort upstream resolver. glibc only falls through to it when
# BOTH dns VMs time out (cold start before the dns plane exists, or a total
# dns outage) — so rig.internal still rides solely on our own dns VMs in
# steady state, while image pulls during first-boot builds don't deadlock on
# a dns plane that isn't up yet. Does NOT undermine the "kill one dns VM"
# redundancy test (that still needs the surviving dns VM for rig.internal).
RIG_BOOTSTRAP_RESOLVER="8.8.8.8"

# Where the host workspace is mapped read-only inside every VM (virtiofs).
RIG_WORKSPACE_MOUNT=/opt/corewaf-workspace
