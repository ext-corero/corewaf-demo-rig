# Copy to .env and adjust. All optional.
# AWS credential for the CoreWAF registry (or export AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
#AWS_PROFILE=corewaf-ecr
# Host ports (change if something else already listens there)
#RIG_HTTP_PORT=8080
#RIG_GRAFANA_PORT=3000
#RIG_STEPCA_PORT=9000
# Guest sizing overrides (MB / vCPUs)
#RIG_APP_RAM_MB=4096
#RIG_OBS_RAM_MB=4096
